[Unit]
Description=mcsman Minecraft server manager
After=network.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
EnvironmentFile=/etc/mcsman/mcsman.env
ExecStart=/usr/local/bin/mcsman --config /etc/mcsman/mcsman.yaml
Restart=on-failure
RestartSec=5s
# Only the daemon gets SIGTERM; it stops servers gracefully itself.
KillMode=mixed
TimeoutStopSec=120
StateDirectory=mcsman
StateDirectoryMode=0750
RuntimeDirectory=mcsman
RuntimeDirectoryMode=0750

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
