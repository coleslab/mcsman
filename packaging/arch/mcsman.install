post_install() {
  # Fill in MCSMAN_JWT_SECRET (only if it isn't set already).
  mcsman-setup secret
  cat <<'MSG'
==> mcsman installed. Finish setup (service user, public URL, tunnel
    detection, first admin account) with:
        sudo mcsman-setup
    Then check everything with:  sudo mcsctl doctor
MSG
}

post_upgrade() {
  mcsman-setup secret >/dev/null
  echo '==> Restart mcsman to apply: sudo systemctl restart mcsman@YOURUSER'
}
